{
    "name": "birta/birta-licence",
    "description": "Reusable branch-based licence management package for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Birta\\Licence\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Birta\\Licence\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Birta\\Licence\\LicenceServiceProvider"
            ],
            "aliases": {
                "Licence": "Birta\\Licence\\Facades\\Licence"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}